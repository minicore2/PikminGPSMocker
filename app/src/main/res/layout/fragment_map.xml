<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    tools:context=".ui.fragments.MapFragment">

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ── Search bar floating overlay ── -->
    <LinearLayout
        android:id="@+id/llSearch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/btnRandomLandmark"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:src="@android:drawable/ic_menu_compass"
            android:background="@color/surface"
            android:tint="@color/accent"
            android:padding="6dp"
            android:contentDescription="隨機地標"/>

        <ImageButton
            android:id="@+id/btnDeleteLandmark"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:src="@android:drawable/ic_menu_delete"
            android:background="@color/surface"
            android:tint="@color/error"
            android:padding="6dp"
            android:visibility="gone"
            android:contentDescription="刪除此地標"/>

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:hint="搜尋地點、地標、路名…"
            android:textColorHint="#555"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:background="@drawable/search_bg"
            android:paddingHorizontal="12dp"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true"/>

        <ImageButton
            android:id="@+id/btnSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:src="@android:drawable/ic_menu_search"
            android:background="@color/accent"
            android:tint="@color/bg_dark"
            android:padding="8dp"
            android:contentDescription="搜尋"/>
    </LinearLayout>

    <!-- ── Search results floating popup ── -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSearchResults"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:visibility="gone"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/llSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSearchResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="300dp"
            android:padding="4dp"
            tools:listitem="@android:layout/simple_list_item_1"/>
    </androidx.cardview.widget.CardView>

    <!-- Zoom Buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toTopOf="@id/fabMyLocation"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnZoomIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:fabSize="mini"
            android:src="@android:drawable/ic_input_add"
            app:tint="@color/bg_dark"
            app:backgroundTint="@color/accent"
            android:contentDescription="放大"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnZoomOut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:fabSize="mini"
            android:src="@android:drawable/ic_input_delete"
            app:tint="@color/bg_dark"
            app:backgroundTint="@color/accent"
            android:contentDescription="縮小"/>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMyLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_menu_mylocation"
        app:layout_constraintBottom_toTopOf="@id/llBottomControls"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/bg_dark"
        app:backgroundTint="@color/accent"
        android:contentDescription="我的位置"/>

    <LinearLayout
        android:id="@+id/llBottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bottom_panel_bg"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:singleSelection="true"
            app:selectionRequired="true">
            <Button
                android:id="@+id/btnModeFixed"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="固定位置"/>
            <Button
                android:id="@+id/btnModeRoute"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="路線模擬"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/tvCoords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="點選地圖或搜尋以設定模擬位置"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="12dp"
            android:gravity="center"/>

        <LinearLayout
            android:id="@+id/routeControlsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <CheckBox
                    android:id="@+id/cbLoop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="循環"
                    android:textColor="@color/text_secondary"/>
                <CheckBox
                    android:id="@+id/cbFollowRoad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="沿道路走"
                    android:textColor="@color/text_secondary"/>
                <CheckBox
                    android:id="@+id/cbReverse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="反向"
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnUndoWp"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                android:layout_marginTop="8dp"
                android:text="撤銷航點"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Button"
                android:textSize="14sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="false"
                android:maxLines="3"
                android:ellipsize="none"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnClear"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="清除"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Button"
                android:textSize="14sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="false"
                android:maxLines="3"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnStartStop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_weight="1"
                android:text="▶ 開始"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Button"
                android:textSize="14sp"
                android:backgroundTint="@color/accent"
                android:textColor="@color/bg_dark"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="false"
                android:maxLines="3" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
