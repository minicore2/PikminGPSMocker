<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Speed card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="12dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="⚡ 移動速度" android:textColor="#888"
                    android:textSize="11sp" android:textAllCaps="true" android:letterSpacing="0.1"/>

                <TextView android:id="@+id/tvSpeedValue"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="1.5 m/s  🚶 步行" android:textColor="@color/text_primary"
                    android:textSize="18sp" android:fontFamily="monospace"
                    android:layout_marginTop="8dp"/>

                <SeekBar android:id="@+id/seekSpeed"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:progress="13" android:max="100"
                    android:thumbTint="@color/accent" android:progressTint="@color/accent"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Start position card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="12dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🚩 路線起始位置" android:textColor="#888"
                    android:textSize="11sp" android:textAllCaps="true" android:letterSpacing="0.1"/>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="設定路線模擬開始時的起點來源"
                    android:textColor="@color/text_secondary" android:textSize="12sp"
                    android:layout_marginTop="4dp" android:layout_marginBottom="8dp"/>

                <RadioGroup android:id="@+id/rgStartFrom"
                    android:layout_width="match_parent" android:layout_height="wrap_content">

                    <RadioButton android:id="@+id/rbStartNone"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="使用地圖上設定的第一個航點"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:buttonTint="@color/accent" android:checked="true"/>

                    <RadioButton android:id="@+id/rbStartLast"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="從上次模擬結束的位置出發"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:buttonTint="@color/accent" android:layout_marginTop="4dp"/>

                    <RadioButton android:id="@+id/rbStartGPS"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="從裝置目前 GPS 位置出發"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:buttonTint="@color/accent" android:layout_marginTop="4dp"/>
                </RadioGroup>

                <TextView android:id="@+id/tvLastPosition"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="（尚無上次位置記錄）"
                    android:textColor="@color/text_secondary" android:textSize="11sp"
                    android:fontFamily="monospace" android:layout_marginTop="6dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Step backend card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="12dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="👟 步數來源" android:textColor="#888"
                    android:textSize="11sp" android:textAllCaps="true" android:letterSpacing="0.1"/>

                <RadioGroup android:id="@+id/rgStepBackend"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton android:id="@+id/rbStepHC"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="❤️ Health Connect（同步健康 App）"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:buttonTint="@color/accent" android:checked="true"/>

                    <RadioButton android:id="@+id/rbStepLocal"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="💾 本地計步（無需授權）"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:buttonTint="@color/accent" android:layout_marginTop="4dp"/>
                </RadioGroup>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnectHC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:layout_marginTop="8dp"
                    android:text="授權 Health Connect"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Button"
                    android:textSize="14sp"
                    android:backgroundTint="@color/accent"
                    android:textColor="@color/bg_dark"
                    android:singleLine="false"
                    android:maxLines="3"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Landmark database card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="12dp">

            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🗺️ 地標資料庫"
                    android:textColor="#888" android:textSize="11sp"
                    android:textAllCaps="true" android:letterSpacing="0.1"/>

                <TextView android:id="@+id/tvLandmarkDbStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="資料庫：讀取中…"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"/>

                <TextView android:id="@+id/tvFetchProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:visibility="gone"/>

                <ProgressBar
                    android:id="@+id/progressFetch"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/accent"
                    android:visibility="gone"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFetchLandmarks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:layout_marginTop="8dp"
                    android:text="從 Wikipedia 更新地標庫"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Button"
                    android:backgroundTint="@color/accent"
                    android:textColor="@color/bg_dark"
                    android:textSize="13sp"
                    android:singleLine="false"
                    android:maxLines="3"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStopFetch"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:layout_marginTop="6dp"
                    android:text="停止抓取"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Button"
                    android:textSize="13sp"
                    android:strokeColor="@color/error"
                    android:textColor="@color/error"
                    android:visibility="gone"
                    android:singleLine="false"
                    android:maxLines="3"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>

                <!-- 地標管理 / 清空全部 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManageLandmarks"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:layout_marginTop="8dp"
                    android:text="管理地標（瀏覽 / 刪除）"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Button"
                    android:strokeColor="@color/accent"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="false"
                    android:maxLines="3"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteAllLandmarks"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:layout_marginTop="6dp"
                    android:text="清空全部地標"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Button"
                    android:textSize="13sp"
                    android:strokeColor="@color/error"
                    android:textColor="@color/error"
                    android:singleLine="false"
                    android:maxLines="3"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#2A3050" android:layout_marginVertical="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExportCsv"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="匯出 CSV"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Button"
                        android:textSize="13sp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:strokeColor="@color/accent"
                        android:textColor="@color/accent"
                        android:singleLine="false"
                        android:maxLines="3"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnImportCsv"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:layout_weight="1"
                        android:text="匯入 CSV"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Button"
                        android:textSize="13sp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:strokeColor="@color/accent"
                        android:textColor="@color/accent"
                        android:singleLine="false"
                        android:maxLines="3"/>
                </LinearLayout>

                <TextView android:id="@+id/tvCsvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- About card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="12dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="PikminGPSMocker" android:textColor="@color/accent"
                    android:textSize="16sp" android:textStyle="bold" android:fontFamily="monospace"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="v3.0.1  ·  minicore with opencode.ai"
                    android:textColor="@color/text_secondary" android:textSize="12sp"
                    android:fontFamily="monospace" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
